---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const newsItems = (await getCollection('news')).filter((item) => !item.data.draft);
  return newsItems.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const pubDate = item.data.pubDate.toISOString().split('T')[0];
---
<!-- ===== 新闻详情页 ===== -->
<BaseLayout title={`${item.data.title} | News`} description={item.data.description} bodyClass="home-warm">
  <main class="publication-archive">
    <section class="publication-hero">
      <div class="container">
        <a class="detail-back" href="/news/" data-en="← News" data-zh="← 新闻">← News</a>
        <span class="label">{pubDate}</span>
        <h1 class="publication-title news-detail-title" data-en={item.data.title} data-zh={item.data.titleZh || item.data.title}>{item.data.title}</h1>
      </div>
    </section>
    <section class="section">
      <div class="prose"><Content /></div>
    </section>
  </main>
</BaseLayout>

<style>
  .news-detail-title { max-width: 860px; text-align: left; }
</style>
