---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<!-- ===== 联系我们页面 ===== -->
<BaseLayout title="Contact | Zhang Lab" description="Contact Zhang Lab at Xinhua Hospital." bodyClass="home-warm">
  <main class="publication-archive">
    <section class="publication-hero">
      <div class="container publication-hero-inner">
        <h1 class="publication-title" data-en="Contact &lt;em&gt;Us&lt;/em&gt;" data-zh="联系我们">Contact <em>Us</em></h1>
        <p class="publication-lede" data-en="For collaborations or inquiries, email the team below." data-zh="合作与咨询，请通过以下邮箱联系。">For collaborations or inquiries, email the team below.</p>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container contact-list">
        <a class="contact-pill" href="mailto:li.zhang@shsmu.edu.cn" aria-label="Email li.zhang@shsmu.edu.cn">
          <span class="contact-pill-name">张力 / ZHANG Li</span>
          <span class="contact-pill-email">
            <svg class="contact-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            li.zhang@shsmu.edu.cn
          </span>
        </a>

        <a class="contact-pill" href="mailto:lastufo@hotmail.com" aria-label="Email lastufo@hotmail.com">
          <span class="contact-pill-name">陈齐山 / CHEN Qishan</span>
          <span class="contact-pill-email">
            <svg class="contact-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            lastufo@hotmail.com
          </span>
        </a>

        <a class="contact-pill" href="mailto:susannayang@126.com" aria-label="Email susannayang@126.com">
          <span class="contact-pill-name">杨眉 / YANG Mei</span>
          <span class="contact-pill-email">
            <svg class="contact-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            susannayang@126.com
          </span>
        </a>

        <div class="institution-card">
          <p class="institution-label" data-en="Affiliation" data-zh="依托单位">Affiliation</p>
          <h2 data-en="Xinhua Hospital Affiliated to Shanghai Jiao Tong University School of Medicine" data-zh="上海交通大学医学院附属新华医院">Xinhua Hospital Affiliated to Shanghai Jiao Tong University School of Medicine</h2>
          <p data-en="1665 Kongjiang Road, Yangpu District, Shanghai 200092, China" data-zh="上海市杨浦区控江路1665号，邮编200092">1665 Kongjiang Road, Yangpu District, Shanghai 200092, China</p>
          <p data-en="Hospital switchboard: +86 21 2507 8999" data-zh="医院总机：021-2507 8999">Hospital switchboard: +86 21 2507 8999</p>
          <a href="https://www.xinhuamed.com.cn/" target="_blank" rel="noreferrer" data-en="Visit the official hospital website →" data-zh="访问新华医院官方网站 →">Visit the official hospital website →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-section { padding-top: 0; }
  .contact-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 760px;
    margin: 0;
  }
  .contact-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 24px 32px 28px;
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
  }
  .contact-pill:hover {
    background: var(--card-hover);
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .contact-pill-name {
    font-family: var(--font-title);
    font-size: 24px;
    font-weight: 650;
    color: #141413;
    letter-spacing: -0.005em;
  }
  .contact-pill-email {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 9px;
    padding: 8px 20px;
    border-radius: 999px;
    background: rgba(232, 230, 220, 0.7);
    border: 1px solid rgba(20, 20, 19, 0.06);
    color: #141413;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 400;
    transition: all 0.2s ease;
  }
  .contact-pill:hover .contact-pill-email {
    background: rgba(217, 119, 87, 0.08);
    border-color: rgba(217, 119, 87, 0.2);
    color: var(--clay-deep);
  }
  .contact-pill-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.2s;
  }
  .contact-pill:hover .contact-pill-icon { opacity: 1; }
  .institution-card {
    width: 100%;
    margin-top: 22px;
    padding: 34px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: transparent;
    text-align: center;
  }
  .institution-label {
    margin: 0 0 12px;
    color: var(--faint);
    font-size: 15px;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .institution-card h2 {
    max-width: 640px;
    margin: 0 auto 16px;
    font-family: var(--font-title);
    font-size: clamp(25px, 3vw, 36px);
    font-weight: 400;
    line-height: 1.25;
  }
  .institution-card p:not(.institution-label) { margin: 6px 0; color: var(--muted); line-height: 1.6; }
  .institution-card a { display: inline-flex; margin-top: 18px; color: var(--clay-deep); font-weight: 650; }
  @media (max-width: 640px) {
    .contact-pill { padding: 20px 20px 24px; }
    .contact-pill-name { font-size: 17px; }
    .contact-pill-email { font-size: 14px; padding: 6px 16px; }
  }
</style>
