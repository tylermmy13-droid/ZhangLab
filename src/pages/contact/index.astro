---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<!-- ===== 联系我们页面 ===== -->
<BaseLayout title="Contact | Zhang Lab" description="Contact Zhang Lab at Xinhua Hospital." bodyClass="home-warm">
  <main class="publication-archive">
    <section class="publication-hero">
      <div class="container publication-hero-inner">
        <h1 class="publication-title" data-en="Contact &lt;em&gt;Us&lt;/em&gt;" data-zh="联系我们">Contact <em>Us</em></h1>
        <p class="publication-lede" data-en="For collaborations or inquiries, email the team below." data-zh="合作与咨询，请通过以下邮箱联系。">For collaborations or inquiries, email the team below.</p>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container contact-list">
        <a class="contact-pill" href="mailto:li.zhang@shsmu.edu.cn" aria-label="Email li.zhang@shsmu.edu.cn">
          <span class="contact-pill-name">张力 / ZHANG Li</span>
          <span class="contact-pill-email">
            <svg class="contact-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            li.zhang@shsmu.edu.cn
          </span>
        </a>

        <a class="contact-pill" href="mailto:lastufo@hotmail.com" aria-label="Email lastufo@hotmail.com">
          <span class="contact-pill-name">陈齐山 / CHEN Qishan</span>
          <span class="contact-pill-email">
            <svg class="contact-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            lastufo@hotmail.com
          </span>
        </a>

        <a class="contact-pill" href="mailto:susannayang@126.com" aria-label="Email susannayang@126.com">
          <span class="contact-pill-name">杨眉 / YANG Mei</span>
          <span class="contact-pill-email">
            <svg class="contact-pill-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            susannayang@126.com
          </span>
        </a>

        <div class="institution-card">
          <p class="institution-label" data-en="Affiliation" data-zh="依托单位">Affiliation</p>
          <h2 data-en="Xinhua Hospital Affiliated to Shanghai Jiao Tong University School of Medicine" data-zh="上海交通大学医学院附属新华医院">Xinhua Hospital Affiliated to Shanghai Jiao Tong University School of Medicine</h2>
          <p data-en="1665 Kongjiang Road, Yangpu District, Shanghai 200092, China" data-zh="上海市杨浦区控江路1665号，邮编200092">1665 Kongjiang Road, Yangpu District, Shanghai 200092, China</p>
          <p data-en="Hospital switchboard: +86 21 2507 8999" data-zh="医院总机：021-2507 8999">Hospital switchboard: +86 21 2507 8999</p>
          <a href="https://www.xinhuamed.com.cn/" target="_blank" rel="noreferrer" data-en="Visit the official hospital website →" data-zh="访问新华医院官方网站 →">Visit the official hospital website →</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-section { padding-top: 32px; }
  .contact-list { display: block; }
  .contact-pill {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 6px 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }
  .contact-pill:first-child { border-top: 1px solid var(--rule); }
  .contact-pill-name {
    font-family: var(--font-title);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.25;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color 180ms ease;
  }
  .contact-pill:hover .contact-pill-name { text-decoration-color: currentColor; }
  .contact-pill-email {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--slate);
    font-family: var(--font-ui);
    font-size: 16px;
    transition: color 180ms ease;
  }
  .contact-pill:hover .contact-pill-email { color: var(--accent); }
  .contact-pill-icon { width: 16px; height: 16px; flex-shrink: 0; opacity: 0.6; }

  .institution-card {
    max-width: 720px;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--ink);
  }
  .institution-label {
    margin: 0 0 12px;
    color: var(--faint);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .institution-card h2 {
    margin: 0 0 14px;
    font-family: var(--font-title);
    font-size: clamp(24px, 2.6vw, 34px);
    font-weight: 400;
    line-height: 1.25;
  }
  .institution-card p:not(.institution-label) { margin: 6px 0; color: var(--muted); font-size: 17px; line-height: 1.6; }
  .institution-card a {
    display: inline-flex;
    margin-top: 16px;
    border-bottom: 1px solid currentColor;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
  }
  @media (max-width: 640px) {
    .contact-pill { grid-template-columns: 1fr; }
    .contact-pill-name { font-size: 22px; }
  }
</style>
