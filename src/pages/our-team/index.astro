---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { team } from '../../data/team';
import { students, studentTypeConfig } from '../../data/students';
import StudentCard from '../../components/StudentCard.astro';

const levels = [1, 2, 3, 4] as const;

const levelConfig: Record<number, { label: string; labelZh: string }> = {
  1: { label: 'Principal Investigator', labelZh: '课题组负责人' },
  2: { label: 'Senior Faculty', labelZh: '高级职称' },
  3: { label: 'Attending Physicians and Research Staff', labelZh: '主治医师及科研人员' },
  4: { label: 'Residents', labelZh: '住院医师' },
};

// Student groups in display order
const studentGroups: Array<{ type: keyof typeof studentTypeConfig }> = [
  { type: 'phd' },
  { type: 'academic-master' },
  { type: 'professional-master' },
];

---
<!-- ===== 团队成员列表页 ===== -->
<!-- 分层次展示 PI、高级职称、主治医师、住院医师及在培学生 -->
<BaseLayout title="Team | Zhang Lab" description="Meet the Zhang Lab team." bodyClass="home-warm">
  <main class="publication-archive">
    <section class="publication-hero">
      <div class="container publication-hero-inner">
        <h1 class="publication-title" data-en="Our &lt;em&gt;Team&lt;/em&gt;" data-zh="团队成员">Our <em>Team</em></h1>
        <p class="publication-lede" data-en="The clinicians, researchers, and trainees in the lab." data-zh="课题组的临床医生、研究人员与在培学生。">The clinicians, researchers, and trainees in the lab.</p>
      </div>
    </section>

    <section class="section team-section">
      <div class="container">
        <div class="team-tree">
          {levels.map((level) => {
            const members = team.filter((m) => m.level === level);
            const cfg = levelConfig[level];
            if (members.length === 0) return null;

            return (
              <div class="team-level" data-level={level}>
                <h2 class="level-label" data-en={cfg.label} data-zh={cfg.labelZh}>{cfg.labelZh}</h2>

                <div class={`level-cards level-cols-${members.length}`}>
                  {members.map((member) => (
                    <a class="member-card" href={`/our-team/${member.slug}/`} data-slug={member.slug}>
                      <div class="member-card-photo">
                        {member.img && <img src={member.img} alt={member.nameZh} loading="lazy" />}
                      </div>
                      <div class="member-card-info">
                        <p class="member-card-name">{member.nameZh}</p>
                        <p class="member-card-name-en">{member.name.split('/')[1]?.trim()}</p>
                        <span class="member-card-role" data-en={member.role} data-zh={member.roleZh}>{member.role}</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ===== 在培学生 ===== -->
    <section class="section students-section">
      <div class="container">
        <h2 class="students-section-title" data-en="Current Students" data-zh="在培学生">在培学生</h2>

        {studentGroups.map((group) => {
          const cfg = studentTypeConfig[group.type];
          const groupStudents = students.filter((s) => s.type === group.type);
          if (groupStudents.length === 0) return null;

          return (
            <div class="student-group">
              <h3 class="student-group-label" data-en={cfg.labelEn} data-zh={cfg.labelZh}>{cfg.labelZh}</h3>
              <div class="student-grid">
                {groupStudents.map((s) => (
                  <StudentCard student={s} />
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .team-section { padding-top: 0; }
  .team-tree { padding-bottom: 32px; }

  .team-level { margin-top: 48px; }
  .team-level:first-child { margin-top: 0; }

  .level-label {
    margin: 0 0 28px;
    padding-top: 14px;
    border-top: 1px solid var(--ink);
    color: var(--faint);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .level-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 40px 32px;
  }

  .member-card { display: block; color: inherit; }

  .member-card-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--paper-deep);
  }
  .member-card-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .member-card-info { padding-top: 14px; }

  .member-card-name {
    margin: 0;
    font-family: var(--font-title);
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color 180ms ease;
  }
  .member-card:hover .member-card-name { text-decoration-color: currentColor; }

  .member-card-name-en {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 15px;
    font-style: italic;
  }

  .member-card-role {
    display: block;
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
    white-space: pre-line;
  }

  /* ===== Students ===== */
  .students-section { padding-top: 24px; }

  .students-section-title {
    margin: 0 0 8px;
    padding-top: 14px;
    border-top: 1px solid var(--ink);
    font-family: var(--font-title);
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .student-group { margin-top: 32px; }

  .student-group-label {
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule);
    color: var(--faint);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .student-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0 32px;
  }

  @media (max-width: 640px) {
    .level-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 16px; }
    .member-card-name { font-size: 18px; }
    .student-grid { grid-template-columns: 1fr; }
  }
</style>
