---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { team } from '../../data/team';

export const getStaticPaths = () => {
  return team.map((m) => ({ params: { slug: m.slug } }));
};

const slug = Astro.params.slug;
const member = team.find((m) => m.slug === slug)!;
const pubs = member.publications;
const honors = member.honors;
const honorsZh = member.honorsZh;

---
<!-- ===== 团队成员详情页 ===== -->
<BaseLayout title={`${member.name} | Zhang Lab`} description={`Zhang Lab profile page of ${member.name}.`} bodyClass="home-warm">
  <main class="publication-archive">
    <section class="section member-page">
      <div class="container">
        <a class="member-back" href="/our-team/" data-en="← Back to Our Team" data-zh="← 返回团队">← Back to Our Team</a>

        <div class="member-header">
          <div class="member-photo">
            {member.img && <img src={member.img} alt={member.nameZh} loading="lazy" />}
          </div>
          <div class="member-info">
            <h1 class="member-name">{member.name}</h1>
            <p class="member-role" data-en={member.role} data-zh={member.roleZh}>{member.role}</p>
            <p class="member-desc" data-en={member.desc} data-zh={member.descZh}>{member.desc}</p>
            {member.email && (
              <div class="member-social">
                <a class="member-social-link" href={`mailto:${member.email}`} aria-label="Email" title={member.email}>
                  <img src="/assets/icons/gmail.svg" alt="Email" /><span>{member.email}</span>
                </a>
              </div>
            )}
          </div>
        </div>

        <!-- Publications -->
        {pubs.length > 0 && (
          <div class="member-section">
            <h2 class="member-section-title" data-en="Publications" data-zh="论文">Publications <span class="pub-count">({pubs.length})</span></h2>
            <div class="pub-list">
              {pubs.map((pub) => (
                <div class="pub-item">
                  <div class="pub-thumb">
                    <img src={pub.img} alt={pub.title} loading="lazy" />
                  </div>
                  <div class="pub-info">
                    <p class="pub-title">
                      {pub.title}
                      {pub.roles?.includes('first') && <span class="pub-role-badge">First Author</span>}
                      {pub.roles?.includes('cofirst') && <span class="pub-role-badge">Co-first Author</span>}
                      {pub.roles?.includes('corresponding') && <span class="pub-role-badge">Corresponding Author</span>}
                    </p>
                    <p class="pub-authors">{pub.authors}</p>
                    <p class="pub-venue">{pub.venue}</p>
                    <div class="pub-links">
                      {pub.links.map((link) => (
                        <a class="pub-link" href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Honors & Awards -->
        {honors.length > 0 && (
          <div class="member-section">
            <h2 class="member-section-title" data-en="Honors &amp; Awards" data-zh="荣誉与奖项">Honors & Awards</h2>
            <ul class="member-list">
              {honors.map((h, i) => <li data-en={h} data-zh={honorsZh[i] || h}>{h}</li>)}
            </ul>
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .member-page { padding-top: 56px; min-height: 80vh; }
  .member-back {
    display: inline-block;
    margin-bottom: 40px;
    color: var(--faint);
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    letter-spacing: 0.04em;
    transition: color 180ms ease;
  }
  .member-back:hover { color: var(--accent); }

  .member-header {
    display: flex;
    gap: clamp(32px, 4vw, 64px);
    align-items: flex-start;
    margin-bottom: 64px;
  }
  .member-photo {
    flex-shrink: 0;
    width: 320px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--paper-deep);
  }
  .member-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .member-info { flex: 1; min-width: 0; padding-top: 4px; }
  .member-name {
    margin: 0 0 8px;
    font-family: var(--font-title);
    font-size: var(--fs-h2);
    font-weight: var(--w-title);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-title);
  }
  .member-role { margin: 0; color: var(--muted); font-size: var(--fs-body); line-height: 1.6; white-space: pre-line; }
  .member-desc {
    max-width: 780px;
    margin: 24px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    color: var(--slate);
    font-family: var(--font-read);
    font-size: var(--fs-prose);
    line-height: 1.8;
    white-space: pre-line;
  }
  .member-social { margin-top: 20px; }
  .member-social-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    transition: color 180ms ease, border-color 180ms ease;
  }
  .member-social-link:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .member-social-link img { width: 16px; height: 16px; filter: brightness(0); opacity: 0.6; }

  .member-section { margin-bottom: 48px; padding-top: 14px; border-top: 1px solid var(--ink); }
  .member-section-title {
    margin: 0 0 8px;
    font-family: var(--font-title);
    font-size: var(--fs-h3);
    font-weight: var(--w-title);
  }
  .pub-count { color: var(--faint); font-size: var(--fs-body); }

  .pub-list { border-top: 1px solid var(--rule); margin-top: 16px; }
  .pub-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 24px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }
  .pub-thumb {
    order: 2;
    overflow: hidden;
    align-self: start;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--paper-deep);
  }
  .pub-thumb img { display: block; width: 100%; aspect-ratio: 8 / 5; object-fit: cover; }
  .pub-info { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .pub-title {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--fs-h4);
    font-weight: var(--w-title);
    line-height: var(--lh-snug);
  }
  .pub-role-badge {
    display: inline;
    margin-left: 8px;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: var(--fs-meta);
    font-weight: var(--w-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pub-authors, .pub-venue { margin: 0; color: var(--muted); font-size: var(--fs-small); line-height: 1.55; }
  .pub-venue { font-family: var(--font-read); font-style: italic; }
  .pub-links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 4px; }
  .pub-link {
    border-bottom: 1px solid currentColor;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: var(--fs-small);
    transition: color 180ms ease;
  }
  .pub-link:hover { color: var(--ink); }

  .member-list { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--rule); }
  .member-list li { padding: 12px 0; border-bottom: 1px solid var(--rule-soft); color: var(--slate); font-size: var(--fs-body); line-height: 1.6; }

  @media (max-width: 720px) {
    .member-header { flex-direction: column; gap: 28px; }
    .member-photo { width: 200px; }
    .pub-item { grid-template-columns: 1fr; }
    .pub-thumb { order: 0; max-width: 260px; }
  }
</style>
