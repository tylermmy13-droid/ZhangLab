---
import BaseLayout from '../layouts/BaseLayout.astro';

const researchAreas = [
  {
    href: '/collections/01-vascular-regeneration/',
    number: '01',
    title: 'Vascular regeneration, repair, and remodeling',
    titleZh: '血管再生修复和重构机制及干预研究',
    description: 'Mechanisms that govern vascular injury, endothelial repair, and pathological remodeling, with an emphasis on translational intervention.',
    descriptionZh: '研究血管损伤、内皮修复与病理性重构的机制，并探索具有转化潜力的干预策略。'
  },
  {
    href: '/collections/02-heart-failure/',
    number: '02',
    title: 'Myocardial infarction, ventricular remodeling, and heart failure',
    titleZh: '心肌梗死、心室重构和心力衰竭的病理机制及转化研究',
    description: 'Cellular and molecular mechanisms of myocardial injury and repair, including the progression from infarction to heart failure.',
    descriptionZh: '研究心肌损伤与修复的细胞和分子机制，关注心肌梗死向心力衰竭进展的过程。'
  },
  {
    href: '/collections/03-multi-organ/',
    number: '03',
    title: 'Cardiovascular multi-organ interactions',
    titleZh: '心血管相关多器官互作的基础与转化研究',
    description: 'Clinical and experimental studies of how cardiovascular disease interacts with metabolic, renal, hepatic, and other organ systems.',
    descriptionZh: '通过临床与实验研究，探讨心血管疾病与代谢、肾脏、肝脏等器官系统之间的相互作用。'
  },
  {
    href: '/collections/04-wearable-devices/',
    number: '04',
    title: 'Wearable devices and proactive health',
    titleZh: '主动健康可穿戴设备医工交叉研究',
    description: 'Medical-engineering research on wearable sensors, physiological signal processing, and longitudinal cardiovascular monitoring.',
    descriptionZh: '围绕可穿戴传感器、生理信号处理和心血管长期监测开展医工交叉研究。'
  },
  {
    href: '/collections/05-ai-cardiovascular/',
    number: '05',
    title: 'AI and cardiovascular medicine',
    titleZh: 'AI与心血管疾病诊治与创新',
    description: 'Reproducible computational methods for cardiovascular imaging, clinical data, risk modeling, and translational discovery.',
    descriptionZh: '面向心血管影像、临床数据、风险建模和转化发现，开发可重复的计算方法。'
  }
];
---
<BaseLayout
  title="About | Zhang Lab"
  description="Zhang Li and Chen Qishan Research Group at Xinhua Hospital, Shanghai Jiao Tong University School of Medicine."
 
  bodyClass="home-warm"
>
  <main class="about-page-standard">
    <section class="publication-hero">
      <div class="container publication-hero-inner">
        <p class="page-eyebrow" data-en="Xinhua Hospital · Shanghai" data-zh="上海 · 新华医院">Xinhua Hospital · Shanghai</p>
        <h1 class="publication-title" data-en="About &lt;em&gt;Zhang Lab&lt;/em&gt;" data-zh="关于&lt;em&gt;张力/陈齐山课题组&lt;/em&gt;">About <em>Zhang Lab</em></h1>
        <p class="publication-lede" data-en="Clinical cardiology and cardiovascular translational research at Shanghai Jiao Tong University School of Medicine." data-zh="依托上海交通大学医学院附属新华医院，开展临床心脏病学与心血管转化研究。">Clinical cardiology and cardiovascular translational research at Shanghai Jiao Tong University School of Medicine.</p>
      </div>
    </section>

    <section class="section about-overview-section">
      <div class="container about-overview-grid">
        <div>
          <p class="page-eyebrow" data-en="Our group" data-zh="课题组简介">Our group</p>
          <h2 class="about-heading" data-en="Research shaped by clinical problems." data-zh="从临床问题出发。">Research shaped by clinical problems.</h2>
        </div>
        <div class="about-overview-copy">
          <p data-en="The Zhang Li and Chen Qishan Research Group is based in the Department of Cardiovascular Medicine at Xinhua Hospital Affiliated to Shanghai Jiao Tong University School of Medicine. The group studies cardiovascular disease from clinical, experimental, and computational perspectives." data-zh="上海交通大学医学院附属新华医院张力/陈齐山课题组依托心血管内科开展工作，从临床、实验与计算研究等角度探索心血管疾病。">The Zhang Li and Chen Qishan Research Group is based in the Department of Cardiovascular Medicine at Xinhua Hospital Affiliated to Shanghai Jiao Tong University School of Medicine. The group studies cardiovascular disease from clinical, experimental, and computational perspectives.</p>
          <p data-en="Our work connects patient-centered questions with vascular biology, myocardial injury and repair, cardiometabolic and multi-organ interactions, wearable monitoring, and data science. Experimental findings are interpreted within clear clinical and translational boundaries." data-zh="课题组将以患者为中心的临床问题与血管生物学、心肌损伤修复、心血管代谢与多器官互作、可穿戴监测及数据科学相结合，并在明确的临床与转化边界内解释研究发现。">Our work connects patient-centered questions with vascular biology, myocardial injury and repair, cardiometabolic and multi-organ interactions, wearable monitoring, and data science. Experimental findings are interpreted within clear clinical and translational boundaries.</p>
          <a class="text-link" href="/our-team/" data-en="Meet the team →" data-zh="查看团队成员 →">Meet the team →</a>
        </div>
      </div>
    </section>

    <section class="section about-leadership-section">
      <div class="container">
        <div class="section-head compact-section-head">
          <div>
            <p class="page-eyebrow" data-en="Leadership" data-zh="导师团队">Leadership</p>
            <h2 class="section-title" data-en="Clinical and scientific leadership" data-zh="临床与科研导师">Clinical and scientific leadership</h2>
          </div>
        </div>
        <div class="leadership-grid">
          <a class="leadership-card" href="/our-team/zhang-li/">
            <img src="/assets/team/zhangli.png" alt="张力 / ZHANG Li" loading="lazy" />
            <div>
              <p class="leadership-name"><strong class="leadership-name-zh">张力</strong><span>ZHANG Li</span></p>
              <p data-en="Vice President of Xinhua Hospital; Director of Cardiology; Distinguished Professor, Chief Physician, and Doctoral Supervisor." data-zh="新华医院副院长、心内科学科带头人，上海交通大学特聘教授、主任医师、博士生导师。">Vice President of Xinhua Hospital; Director of Cardiology; Distinguished Professor, Chief Physician, and Doctoral Supervisor.</p>
              <span class="text-link" data-en="Full profile →" data-zh="完整简介 →">Full profile →</span>
            </div>
          </a>
          <a class="leadership-card" href="/our-team/chen-qishan/">
            <img src="/assets/team/chenqishan.jpg" alt="陈齐山 / CHEN Qishan" loading="lazy" />
            <div>
              <p class="leadership-name"><strong class="leadership-name-zh">陈齐山</strong><span>CHEN Qishan</span></p>
              <p data-en="Deputy Director of Cardiovascular Medicine (Acting Director); Associate Chief Physician, Associate Researcher, and Doctoral Supervisor." data-zh="心血管内科副主任（主持工作），副主任医师、副研究员、博士生导师。">Deputy Director of Cardiovascular Medicine (Acting Director); Associate Chief Physician, Associate Researcher, and Doctoral Supervisor.</p>
              <span class="text-link" data-en="Full profile →" data-zh="完整简介 →">Full profile →</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section about-research-section">
      <div class="container">
        <div class="section-head compact-section-head">
          <div>
            <p class="page-eyebrow" data-en="Research" data-zh="主要研究方向">Research</p>
            <h2 class="section-title" data-en="Five connected research areas" data-zh="五个相互衔接的研究方向">Five connected research areas</h2>
          </div>
        </div>
        <div class="about-research-grid">
          {researchAreas.map((area) => (
            <a class="about-research-card" href={area.href}>
              <span class="about-research-number">{area.number}</span>
              <h3 data-en={area.title} data-zh={area.titleZh}>{area.title}</h3>
              <p data-en={area.description} data-zh={area.descriptionZh}>{area.description}</p>
              <span class="text-link" data-en="Explore this area →" data-zh="查看方向详情 →">Explore this area →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-overview-section { padding-top: 40px; }
  .about-overview-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(40px, 7vw, 104px);
    padding-top: 28px;
  }
  .about-heading {
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(34px, 4vw, 54px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .about-overview-copy p {
    margin: 0 0 20px;
    color: var(--slate);
    font-size: 19px;
    line-height: 1.75;
  }
  .text-link {
    display: inline-flex;
    padding: 2px 0;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 500;
    transition: color 180ms ease, border-color 180ms ease;
  }
  a:hover > .text-link,
  .about-overview-copy .text-link:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .compact-section-head { margin-bottom: 8px; }

  .leadership-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
    border-top: 1px solid var(--rule);
  }
  .leadership-card {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }
  .leadership-card img {
    width: 210px;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    object-fit: cover;
  }
  .leadership-card p { margin: 0 0 14px; color: var(--slate); font-size: 17px; line-height: 1.65; }
  .leadership-card .leadership-name {
    color: var(--ink);
    font-family: var(--font-title);
    font-size: 28px;
    line-height: 1.2;
  }
  .leadership-name-zh {
    display: block;
    font-family: "Source Han Serif CN Bold", "Noto Serif SC", "Songti SC", serif;
    font-weight: 700;
  }
  .leadership-name span {
    display: block;
    margin-top: 4px;
    color: var(--faint);
    font-family: var(--font-ui);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .about-research-section { padding-top: 24px; }
  .about-research-grid { border-top: 1px solid var(--rule); }
  .about-research-card {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    column-gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }
  .about-research-number {
    grid-row: 1 / span 3;
    color: var(--faint);
    font-family: var(--font-title);
    font-size: 30px;
    line-height: 1.2;
  }
  .about-research-card h3,
  .about-research-card p,
  .about-research-card .text-link { grid-column: 2; }
  .about-research-card h3 {
    margin: 0 0 8px;
    font-family: var(--font-title);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 400;
    line-height: 1.2;
  }
  .about-research-card p { max-width: 640px; margin: 0; color: var(--muted); font-size: 17px; line-height: 1.65; }
  .about-research-card .text-link { justify-self: start; margin-top: 14px; }

  @media (max-width: 960px) {
    .leadership-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .about-overview-grid { grid-template-columns: 1fr; gap: 24px; }
    .about-research-card { grid-template-columns: 40px minmax(0, 1fr); column-gap: 16px; }
    .about-research-number { font-size: 22px; }
  }
  @media (max-width: 480px) {
    .leadership-card { grid-template-columns: 110px minmax(0, 1fr); gap: 16px; }
    .leadership-card img { width: 110px; }
  }
</style>
