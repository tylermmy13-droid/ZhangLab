---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const collectionItems = (await getCollection('collections')).filter((item) => !item.data.draft);
  return collectionItems.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<!-- ===== Research Area Detail — Warm, editorial, unified ===== -->
<BaseLayout title={`${item.data.title} | Research`} description={item.data.description} bodyClass="home-warm">
  <main class="collection-detail">
    <section class="detail-hero">
      <div class="container">
        <a class="detail-back" href="/collections/" data-en="← Research Areas" data-zh="← 研究方向">← Research Areas</a>
        <p class="detail-label" data-en={item.data.platform} data-zh={item.data.platformZh}>{item.data.platform}</p>
        <h1 data-en={item.data.title} data-zh={item.data.titleZh}>{item.data.title}</h1>
        <p class="detail-description" data-en={item.data.description} data-zh={item.data.descriptionZh}>{item.data.description}</p>
        <div class="detail-meta">
          {item.data.tags?.map((tag) => <span>{tag}</span>)}
        </div>
      </div>
    </section>

    <section class="section detail-cover-section">
      <div class="container">
        <div class="detail-cover">
          <img src={item.data.image} alt={item.data.titleZh} />
        </div>
      </div>
    </section>

    <section class="section detail-body">
      <div class="container">
        <div class="prose"><Content /></div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .detail-hero { padding-top: 56px; padding-bottom: 40px; }
  .detail-back { margin-bottom: 48px; }
  .detail-label {
    margin: 0 0 18px;
    color: var(--faint);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .detail-cover-section { padding-top: 0; padding-bottom: 64px; }
  .detail-body { padding-top: 0; padding-bottom: 112px; }
  @media (max-width: 720px) {
    .detail-hero { padding-top: 32px; }
  }
</style>
