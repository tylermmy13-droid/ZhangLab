---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const collectionItems = (await getCollection('collections'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<!-- ===== 研究方向：编号列表，每项一行 ===== -->
<BaseLayout title="Research Areas | Zhang Lab" description="Five research areas in cardiovascular medicine." bodyClass="home-warm">
  <main class="collection-archive">
    <section class="collection-hero">
      <div class="container collection-hero-inner">
        <h1 class="collection-title" data-en="Research <em>Areas</em>" data-zh="研究<em>方向</em>">Research <em>Areas</em></h1>
        <p class="collection-lede" data-en="The questions we work on in cardiovascular medicine." data-zh="我们关注的心血管医学问题。">The questions we work on in cardiovascular medicine.</p>
      </div>
    </section>

    <section class="section directions-section">
      <div class="container">
        <div class="directions-list">
          {collectionItems.map((item, index) => {
            const num = String(index + 1).padStart(2, '0');
            return (
              <a class="direction-card" href={`/collections/${item.id}/`}>
                <span class="direction-card-number" aria-hidden="true">{num}</span>
                <div class="direction-card-body">
                  <span class="label" data-en={item.data.platform} data-zh={item.data.platformZh}>{item.data.platform}</span>
                  <h2 class="direction-card-title" data-en={item.data.title} data-zh={item.data.titleZh}>{item.data.title}</h2>
                  <p class="direction-card-desc" data-en={item.data.description} data-zh={item.data.descriptionZh}>{item.data.description}</p>
                </div>
                <div class="direction-card-media">
                  <img src={item.data.image} alt={item.data.titleZh} loading="lazy" />
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .directions-section { padding-top: 0; padding-bottom: 112px; }
  .directions-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .direction-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow-paper);
  }
  .direction-card-number { display: none; }
  .direction-card-media { order: -1; overflow: hidden; }
  .direction-card-media img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform 500ms ease; }
  .direction-card:hover .direction-card-media img { transform: scale(1.025); }
  .direction-card-body { display: flex; flex-direction: column; flex: 1; padding: 28px 30px 32px; }
  .direction-card-title {
    margin: 0 0 12px;
    font-family: var(--font-title);
    font-size: var(--fs-h3);
    font-weight: var(--w-title);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-sub);
    text-wrap: pretty;
    transition: color 180ms ease;
  }
  .direction-card:hover .direction-card-title { color: var(--accent); }
  .direction-card-desc { margin: 0; color: var(--muted); font-size: var(--fs-body); line-height: 1.7; }
  .direction-card:last-child { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); }
  .direction-card:last-child .direction-card-media { order: 0; }
  .direction-card:last-child .direction-card-media img { height: 100%; aspect-ratio: auto; }
  @media (max-width: 700px) {
    .directions-list { grid-template-columns: 1fr; gap: 18px; }
    .direction-card:last-child { display: flex; }
    .direction-card:last-child .direction-card-media { order: -1; }
    .direction-card:last-child .direction-card-media img { height: auto; aspect-ratio: 16 / 9; }
    .direction-card-body { padding: 24px; }
  }
</style>
