---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const collectionItems = (await getCollection('collections'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<!-- ===== 研究方向：编号列表，每项一行 ===== -->
<BaseLayout title="Research Areas | Zhang Lab" description="Five research areas in cardiovascular medicine." bodyClass="home-warm">
  <main class="collection-archive">
    <section class="collection-hero">
      <div class="container collection-hero-inner">
        <h1 class="collection-title" data-en="Research <em>Areas</em>" data-zh="研究<em>方向</em>">Research <em>Areas</em></h1>
        <p class="collection-lede" data-en="The questions we work on in cardiovascular medicine." data-zh="我们关注的心血管医学问题。">The questions we work on in cardiovascular medicine.</p>
      </div>
    </section>

    <section class="section directions-section">
      <div class="container">
        <div class="directions-list">
          {collectionItems.map((item, index) => {
            const num = String(index + 1).padStart(2, '0');
            return (
              <a class="direction-card" href={`/collections/${item.id}/`}>
                <span class="direction-card-number" aria-hidden="true">{num}</span>
                <div class="direction-card-body">
                  <span class="label" data-en={item.data.platform} data-zh={item.data.platformZh}>{item.data.platform}</span>
                  <h2 class="direction-card-title" data-en={item.data.title} data-zh={item.data.titleZh}>{item.data.title}</h2>
                  <p class="direction-card-desc" data-en={item.data.description} data-zh={item.data.descriptionZh}>{item.data.description}</p>
                </div>
                <div class="direction-card-media">
                  <img src={item.data.image} alt={item.data.titleZh} loading="lazy" />
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .directions-section { padding-top: 0; padding-bottom: 96px; }

  .direction-card {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 360px;
    gap: 0 32px;
    align-items: start;
    padding: 40px 0;
    border-bottom: 1px solid var(--rule);
  }

  .direction-card-number {
    color: var(--faint);
    font-family: var(--font-title);
    font-size: 34px;
    line-height: 1.1;
  }

  .direction-card-body { min-width: 0; }

  .direction-card-title {
    margin: 0 0 10px;
    font-family: var(--font-title);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-decoration-color 180ms ease;
  }
  .direction-card:hover .direction-card-title { text-decoration-color: currentColor; }

  .direction-card-desc {
    max-width: 640px;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.65;
  }

  .direction-card-media {
    overflow: hidden;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--paper-deep);
  }
  .direction-card-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  :global(html[lang="zh-CN"]) .direction-card-title { font-weight: 600; }

  @media (max-width: 860px) {
    .direction-card { grid-template-columns: 44px minmax(0, 1fr) 170px; gap: 0 18px; padding: 24px 0; }
    .direction-card-number { font-size: 24px; }
  }
  @media (max-width: 560px) {
    .direction-card { grid-template-columns: minmax(0, 1fr) 132px; }
    .direction-card-number { display: none; }
  }
</style>
