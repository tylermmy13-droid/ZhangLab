---
// 获取最新新闻、论文、研究方向各3条（排除草稿，按日期倒序）
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import NewsCard from '../components/NewsCard.astro';
import PublicationCard from '../components/PublicationCard.astro';
import CollectionCard from '../components/CollectionCard.astro';

const newsItems = (await getCollection('news')).filter((item) => !item.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const publications = (await getCollection('publications')).filter((item) => !item.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const collectionItems = (await getCollection('collections')).filter((item) => !item.data.draft).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()).slice(0, 3);
---
<!-- ===== 首页 ===== -->
<!-- 展示首页首屏与最新三条新闻、研究方向、论文 -->
<BaseLayout title="Zhang Lab | Xinhua Hospital" description="The Zhang Li and Qishan Chen Research Group conducts cardiovascular and translational research at Xinhua Hospital." bodyClass="home-warm">
  <main class="home-page">
    <HomeHero />

    <!-- ===== 最新动态 ===== -->
    <section class="section" id="news">
      <div class="container">
        <div class="section-head">
          <div class="section-head-top">
            <h2 class="section-title" data-en="Latest &lt;em&gt;News&lt;/em&gt;" data-zh="最新&lt;em&gt;动态&lt;/em&gt;">Latest <em>News</em></h2>
            <a class="button section-cta" href="/news/" data-en="All News" data-zh="全部动态">All News <span aria-hidden="true">&rarr;</span></a>
          </div>
          <p class="section-copy" data-en="Latest from the lab." data-zh="课题组最新消息。">Latest from the lab.</p>
        </div>
        <div class="card-grid">{newsItems.map((item) => <NewsCard item={item} />)}</div>
      </div>
    </section>

    <!-- ===== 研究方向 ===== -->
    <section class="section" id="collections">
      <div class="container">
        <div class="section-head">
          <div class="section-head-top">
            <h2 class="section-title" data-en="Research &lt;em&gt;Areas&lt;/em&gt;" data-zh="研究&lt;em&gt;方向&lt;/em&gt;">Research <em>Areas</em></h2>
            <a class="button section-cta" href="/collections/" data-en="All Research Areas" data-zh="全部方向">All Research Areas <span aria-hidden="true">&rarr;</span></a>
          </div>
          <p class="section-copy" data-en="Our current research directions." data-zh="我们目前的研究方向。">Our current research directions.</p>
        </div>
        <div class="card-grid">{collectionItems.map((item) => <CollectionCard item={item} />)}</div>
      </div>
    </section>

    <!-- ===== 代表性论文 ===== -->
    <section class="section" id="publications">
      <div class="container">
        <div class="section-head">
          <div class="section-head-top">
            <h2 class="section-title" data-en="Representative &lt;em&gt;Publications&lt;/em&gt;" data-zh="代表性&lt;em&gt;论文&lt;/em&gt;">Representative <em>Publications</em></h2>
            <a class="button section-cta" href="/publications/" data-en="All Publications" data-zh="全部论文">All Publications <span aria-hidden="true">&rarr;</span></a>
          </div>
          <p class="section-copy" data-en="Selected publications from the lab." data-zh="课题组代表性论文。">Selected publications from the lab.</p>
        </div>
        <div class="card-grid">{publications.map((item) => <PublicationCard item={item} />)}</div>
      </div>
    </section>
  </main>
</BaseLayout>
