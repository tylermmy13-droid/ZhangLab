---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import NewsCard from '../components/NewsCard.astro';
import PublicationCard from '../components/PublicationCard.astro';

const newsItems = (await getCollection('news')).filter((item) => !item.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const publications = (await getCollection('publications')).filter((item) => !item.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
const collectionItems = (await getCollection('collections')).filter((item) => !item.data.draft).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---
<BaseLayout title="Zhang Lab | Xinhua Hospital" description="The Zhang Li and Chen Qishan Research Group conducts cardiovascular and translational research at Xinhua Hospital." bodyClass="home-warm">
  <main class="home-page">
    <HomeHero />

    <section class="section home-research" id="collections">
      <div class="container">
        <div class="section-head">
          <div class="section-head-top">
            <h2 class="section-title" data-en="Connected questions.&lt;br /&gt;One research program." data-zh="从机制到临床，&lt;br /&gt;彼此连接的研究。">从机制到临床，<br />彼此连接的研究。</h2>
            <a class="button section-cta" href="/collections/" data-en="View all research" data-zh="全部研究方向">View all research <span aria-hidden="true">↗</span></a>
          </div>
          <p class="section-copy" data-en="We bring together vascular biology, clinical cardiology, engineering, and data science to understand and treat cardiovascular disease." data-zh="融合血管生物学、临床心脏病学、工程与数据科学，理解并干预心血管疾病。">融合血管生物学、临床心脏病学、工程与数据科学，理解并干预心血管疾病。</p>
        </div>
        <div class="area-row">
          {collectionItems.map((item) => (
            <a class="area" href={`/collections/${item.id}/`}>
              <span class="area-media"><img src={item.data.image} alt={item.data.titleZh} loading="lazy" /></span>
              <span class="area-content">
                <span class="label" data-en={item.data.platform} data-zh={item.data.platformZh}>{item.data.platform}</span>
                <h3 data-en={item.data.title} data-zh={item.data.titleZh}>{item.data.title}</h3>
                <p data-en={item.data.description} data-zh={item.data.descriptionZh}>{item.data.description}</p>
                <span class="area-link" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 18 18 6M6 6h12v12" /></svg></span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section home-publications" id="publications">
      <div class="container">
        <div class="section-head">
          <div class="section-head-top">
            <h2 class="section-title" data-en="Selected publications" data-zh="代表性论文">代表性论文</h2>
            <a class="button section-cta" href="/publications/" data-en="All publications" data-zh="全部论文">All publications <span aria-hidden="true">↗</span></a>
          </div>
          <p class="section-copy" data-en="Recent work across cardiovascular biology and medicine." data-zh="近期心血管生物学与医学研究成果。">近期心血管生物学与医学研究成果。</p>
        </div>
        <div class="card-grid">{publications.map((item) => <PublicationCard item={item} />)}</div>
      </div>
    </section>

    <section class="section home-news" id="news">
      <div class="container">
        <div class="section-head">
          <div class="section-head-top">
            <h2 class="section-title" data-en="From the lab" data-zh="课题组动态">课题组动态</h2>
            <a class="button section-cta" href="/news/" data-en="All news" data-zh="全部动态">All news <span aria-hidden="true">↗</span></a>
          </div>
          <p class="section-copy" data-en="Research milestones, publications, and life in the group." data-zh="记录研究进展、学术成果与团队近况。">记录研究进展、学术成果与团队近况。</p>
        </div>
        <div class="card-grid">{newsItems.map((item) => <NewsCard item={item} />)}</div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-research { background: var(--sage); }
  .home-research .section-head { border-top-color: var(--ink); }
  .home-research .section-copy { max-width: 660px; }
  .area-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
  }
  .area {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--rule-soft);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 1px 2px rgba(27, 37, 31, 0.03);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .area:hover { transform: translateY(-4px); box-shadow: var(--shadow-paper); }
  .area-media { display: block; overflow: hidden; background: var(--paper-deep); }
  .area-media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 500ms ease; }
  .area:hover .area-media img { transform: scale(1.03); }
  .area-content { position: relative; display: flex; flex-direction: column; flex: 1; padding: 22px 20px 24px; }
  .area .label { min-height: 36px; margin-bottom: 12px; font-size: 11px; }
  .area h3 {
    margin: 0 0 12px;
    font-family: var(--font-title);
    font-size: clamp(20px, 1.6vw, 25px);
    font-weight: var(--w-title);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-sub);
    text-wrap: pretty;
    transition: color 180ms ease;
  }
  .area:hover h3 { color: var(--accent); }
  .area p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .area-link { display: block; align-self: flex-end; margin-top: 22px; color: var(--accent); }
  .area-link svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .home-publications { background: var(--paper); }
  .home-news { padding-top: 0; }

  @media (min-width: 1241px) {
    .area-content { padding: 26px 24px 28px; }
    .area h3 { font-size: clamp(21px, 1.55vw, 27px); }
    .area p { font-size: 15px; }
  }
  @media (max-width: 1240px) {
    .area-row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .area:nth-child(n + 4) { display: grid; grid-template-columns: 130px minmax(0, 1fr); grid-column: span 1; }
    .area:nth-child(n + 4) .area-media img { height: 100%; aspect-ratio: auto; }
    .area:nth-child(n + 4) .area-content { padding: 18px 16px; }
    .area:nth-child(n + 4) .label { min-height: 0; }
    .area:nth-child(n + 4) p { display: none; }
    .area:nth-child(n + 4) h3 { font-size: 20px; }
  }
  @media (max-width: 860px) {
    .area-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .area:nth-child(n + 4) { display: flex; }
    .area:nth-child(n + 4) .area-media img { height: auto; aspect-ratio: 4 / 3; }
    .area:nth-child(n + 4) .area-content { padding: 22px 20px 24px; }
    .area:nth-child(n + 4) p { display: block; }
    .area:last-child { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr); }
    .area:last-child .area-media img { height: 100%; aspect-ratio: auto; }
  }
  @media (max-width: 640px) {
    .area-row {
      display: flex;
      gap: 14px;
      margin-right: calc(-1 * var(--gutter));
      padding-right: var(--gutter);
      padding-bottom: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .area-row::-webkit-scrollbar { display: none; }
    .area, .area:nth-child(n + 4), .area:last-child {
      display: flex;
      flex: 0 0 80%;
      scroll-snap-align: start;
    }
    .area:nth-child(n + 4) .area-media img, .area:last-child .area-media img { height: auto; aspect-ratio: 4 / 3; }
    .area-content, .area:nth-child(n + 4) .area-content { padding: 20px; }
    .area h3, .area:nth-child(n + 4) h3 { font-size: 22px; }
    .area p, .area:nth-child(n + 4) p { display: block; }
  }
</style>
