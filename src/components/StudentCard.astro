---
import type { StudentMember } from '../data/students';

const { student } = Astro.props as { student: StudentMember };

const enName = student.name.split('/')[1]?.trim() || '';

const typeLabels: Record<string, { en: string; zh: string }> = {
  'phd':                { en: 'Ph.D.', zh: '博士研究生' },
  'academic-master':    { en: 'M.Phil.', zh: '学术型硕士' },
  'professional-master':{ en: 'M.Med.', zh: '专业型硕士' },
};
const roleLabel = typeLabels[student.type] ?? { en: '', zh: '' };
---
<!-- ===== 学生条目：纯文字，无头像与边框 ===== -->
<div class="student-card">
  <p class="student-card-name">{student.nameZh} <span class="student-card-name-en">{enName}</span></p>
  <p class="student-card-meta">
    <span data-en={roleLabel.en} data-zh={roleLabel.zh}>{roleLabel.zh}</span>
    {student.program && (
      <span> · <span data-en={student.program} data-zh={student.programZh || student.program}>{student.programZh || student.program}</span></span>
    )}
    · <span data-en={`Enrolled ${student.enrollmentYear}`} data-zh={`${student.enrollmentYear}级`}>{student.enrollmentYear}级</span>
  </p>
</div>

<style>
  .student-card {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .student-card-name {
    margin: 0;
    font-family: var(--font-title);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
  }
  .student-card-name-en {
    color: var(--muted);
    font-size: 14px;
    font-weight: 400;
  }
  .student-card-meta {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>
