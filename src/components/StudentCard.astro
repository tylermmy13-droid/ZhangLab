---
import type { StudentMember } from '../data/students';

const { student, accent } = Astro.props as {
  student: StudentMember;
  accent: string;
};

const initial = student.nameZh.charAt(0);
const enName = student.name.split('/')[1]?.trim() || '';

const typeLabels: Record<string, { en: string; zh: string }> = {
  'phd':                { en: 'Ph.D.', zh: '博士研究生' },
  'academic-master':    { en: 'M.Phil.', zh: '学术型硕士' },
  'professional-master':{ en: 'M.Med.', zh: '专业型硕士' },
};
const roleLabel = typeLabels[student.type] ?? { en: '', zh: '' };
---
<!-- ===== 学生卡片组件 ===== -->
<div class="student-card" style={`--card-accent: ${accent}`}>
  <div class="student-card-avatar">
    <span class="student-card-initial">{initial}</span>
  </div>
  <div class="student-card-info">
    <p class="student-card-name">{student.nameZh}</p>
    <p class="student-card-name-en">{enName}</p>
    <span class="student-card-role" style={`background: ${accent}18`} data-en={roleLabel.en} data-zh={roleLabel.zh}>
      {roleLabel.zh}
    </span>
    {student.program && (
      <span class={`student-card-role student-card-program${student.program === 'Hainan Special Program' ? ' is-blue' : ''}`} data-en={student.program} data-zh={student.programZh || student.program}>
        {student.programZh || student.program}
      </span>
    )}
    <p class="student-card-enrollment" data-en={`Enrolled ${student.enrollmentYear}`} data-zh={`${student.enrollmentYear}级`}>
      {student.enrollmentYear}级
    </p>
  </div>
</div>

<style>
  .student-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
    text-decoration: none;
    transition: all 0.3s ease;
    flex-shrink: 0;
    cursor: default;
  }
  .student-card:hover {
    background: var(--card-hover);
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .student-card-avatar {
    width: 100%;
    aspect-ratio: 1 / 0.72;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--oat);
  }
  .student-card-initial {
    font-size: 37px;
    font-weight: 600;
    color: rgba(20, 20, 19, 0.15);
    font-family: "Inter", sans-serif;
    user-select: none;
  }
  .student-card-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 14px 12px 18px;
    gap: 4px;
    width: 100%;
  }
  .student-card-name {
    margin: 0;
    color: #141413;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }
  .student-card-name-en {
    margin: 0;
    color: #141413;
    font-family: var(--font-title);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.015em;
    opacity: 0.55;
  }
  .student-card-role {
    display: inline-block;
    margin-top: 5px;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #141413 !important;
  }
  .student-card-program {
    margin-top: 2px;
    color: var(--clay-deep) !important;
    background: rgba(217, 119, 87, 0.12);
  }
  .student-card-program.is-blue {
    color: #3f6a99 !important;
    background: rgba(106, 155, 204, 0.12);
  }
  .student-card-enrollment {
    margin: 3px 0 0;
    color: #141413;
    font-size: 12px;
    opacity: 0.55;
  }
</style>
