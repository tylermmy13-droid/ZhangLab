<div class="lang-switch" id="langSwitch" data-active="zh" role="radiogroup" aria-label="语言切换 / Language Switch">
  <button class="lang-option active" type="button" role="radio" aria-checked="true" data-lang="zh">中文</button>
  <button class="lang-option" type="button" role="radio" aria-checked="false" data-lang="en">EN</button>
  <div class="lang-slider"></div>
</div>

<style>
  /* Set like "中文 / EN": the current language in ink, the other one muted. */
  .lang-switch {
    display: flex;
    align-items: baseline;
    flex-shrink: 0;
    font-family: var(--font-ui);
  }
  .lang-option {
    padding: 8px 0 7px;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--faint);
    font: inherit;
    font-size: 15px;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }
  .lang-option + .lang-option::before {
    content: "/";
    display: inline-block;
    margin: 0 10px;
    color: var(--rule);
  }
  .lang-option:hover { color: var(--ink); }
  .lang-option.active { color: var(--ink); pointer-events: none; }
  /* The old sliding highlight is not used; the element stays so the script keeps working. */
  .lang-slider { display: none; }
</style>
