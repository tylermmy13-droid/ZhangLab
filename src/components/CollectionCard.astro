---
const { item } = Astro.props;
const href = `/collections/${item.id}/`;
---
<!-- ===== 研究方向卡片组件（支持中英文；样式见 global.css 的 .card） ===== -->
<a class="card collection-card" href={href}>
  <span class="card-media">
    <img class="card-image" src={item.data.image} alt={item.data.titleZh} loading="lazy" />
  </span>
  <div class="collection-card-body">
    <span class="tag-pill" data-en={item.data.platform} data-zh={item.data.platformZh}>{item.data.platform}</span>
    <h3 class="collection-card-title" data-en={item.data.title} data-zh={item.data.titleZh}>{item.data.title}</h3>
    <p data-en={item.data.description} data-zh={item.data.descriptionZh}>{item.data.description}</p>
  </div>
</a>
