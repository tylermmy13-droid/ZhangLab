<!-- ===== 首页首屏：标题在上，荧光图从底部露出，向下滚动时展开占满页面 ===== -->
<section class="home-hero" data-home-hero>
  <div class="home-hero-sticky">
    <div class="home-hero-content">
      <p class="home-hero-eyebrow" data-en="Xinhua Hospital · Shanghai Jiao Tong University School of Medicine" data-zh="上海交通大学医学院附属新华医院">Xinhua Hospital · Shanghai Jiao Tong University School of Medicine</p>
      <h1 class="home-hero-title" data-en="Cardiovascular research,&lt;br /&gt;grounded in clinical questions." data-zh="从临床问题出发的&lt;br /&gt;心血管医学研究">Cardiovascular research,<br />grounded in clinical questions.</h1>
      <p class="home-hero-tagline" data-en="The Zhang Li and Chen Qishan Research Group." data-zh="张力/陈齐山课题组">The Zhang Li and Chen Qishan Research Group.</p>
      <p class="home-hero-links">
        <a class="button is-primary" href="/collections/"><span data-en="Research Areas" data-zh="研究方向">Research Areas</span> <span aria-hidden="true">&rarr;</span></a>
        <a class="button is-secondary" href="/our-team/"><span data-en="Team" data-zh="团队">Team</span> <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>

    <div class="home-hero-media" data-home-hero-media>
      <img src="/assets/home/cardiovascular-figure.jpg" alt="Cardiovascular fluorescence microscopy image" />
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  const header = document.querySelector<HTMLElement>('[data-scroll-header]');
  const copy = hero?.querySelector<HTMLElement>('.home-hero-content');

  if (hero) {
    let frame = 0;

    const updateHero = () => {
      frame = 0;
      // The sticky header stays on screen, so the scene lives in the space below it.
      const headerHeight = header?.offsetHeight ?? 0;
      const stage = window.innerHeight - headerHeight;
      const sceneLength = Math.max(hero.offsetHeight - stage, 1);
      const raw = Math.min(Math.max((headerHeight - hero.getBoundingClientRect().top) / sceneLength, 0), 1);
      const progress = Math.min(raw / 0.7, 1);
      const eased = progress * progress * (3 - 2 * progress);

      // The picture starts exactly as wide as the text column, then grows to the full page.
      const startInset = copy ? copy.getBoundingClientRect().left : 24;
      const startHeight = Math.max(stage * 0.72, 380);
      const peek = Math.min(280, Math.max(150, stage * 0.3));

      hero.style.setProperty('--hero-top', `${headerHeight}px`);
      hero.style.setProperty('--hero-stage', `${stage}px`);
      hero.style.setProperty('--hero-media-top', `${(stage - peek) * (1 - eased)}px`);
      hero.style.setProperty('--hero-media-inset', `${startInset * (1 - eased)}px`);
      hero.style.setProperty('--hero-media-height', `${startHeight + (stage - startHeight) * eased}px`);
      hero.style.setProperty('--hero-media-radius', `${12 * (1 - eased)}px`);
      hero.style.setProperty('--hero-copy-opacity', `${Math.max(0, 1 - raw * 2.6)}`);
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateHero);
    };

    updateHero();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  }
</script>

<style>
  .home-hero {
    position: relative;
    z-index: 2;
    height: 220vh;
    height: 220dvh;
    background: var(--paper);
  }

  .home-hero-sticky {
    position: sticky;
    top: var(--hero-top, 96px);
    height: var(--hero-stage, calc(100vh - 96px));
    overflow: hidden;
  }

  /* Set on the left edge of the page grid, like a title page, not centered. */
  .home-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    width: min(calc(100% - 48px), var(--max));
    height: 100%;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 56px) 0 clamp(210px, 32vh, 340px);
    opacity: var(--hero-copy-opacity, 1);
  }

  .home-hero-eyebrow {
    margin: 0 0 clamp(16px, 2.6vh, 28px);
    padding-top: 14px;
    border-top: 2px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: var(--fs-meta);
    font-weight: var(--w-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .home-hero-title {
    max-width: none;
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--fs-display);
    font-weight: var(--w-title);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-title);
  }

  .home-hero-tagline {
    max-width: 640px;
    margin: clamp(16px, 2.4vh, 28px) 0 0;
    color: var(--muted);
    font-size: var(--fs-lede);
    line-height: 1.55;
  }

  .home-hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: clamp(22px, 3vh, 34px) 0 0;
  }

  /* Plain underlined links, the same voice as every other link on the site. */
  .home-hero-links .button { font-size: var(--fs-body); }
  .home-hero-links .button:not(.is-secondary) { color: var(--accent); border-bottom-color: var(--accent); }
  .home-hero-links .button:not(.is-secondary):hover { color: var(--accent-deep); border-bottom-color: var(--accent-deep); }

  .home-hero-media {
    position: absolute;
    z-index: 3;
    top: var(--hero-media-top, 70%);
    right: var(--hero-media-inset, 48px);
    left: var(--hero-media-inset, 48px);
    height: var(--hero-media-height, 72%);
    overflow: hidden;
    border-radius: var(--hero-media-radius, 12px);
    background: #050505;
    will-change: top, left, right, height, border-radius;
  }

  .home-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .home-hero-content { width: calc(100% - 32px); }
    .home-hero-links { gap: 12px 24px; }
  }
</style>
