<!-- ===== 首页首屏：标题在上，荧光图从底部露出，向下滚动时展开占满页面 ===== -->
<section class="home-hero" data-home-hero>
  <div class="home-hero-sticky">
    <div class="home-hero-content">
      <h1 class="home-hero-title" data-en="Cardiovascular research,&lt;br /&gt;grounded in clinical questions." data-zh="从临床问题出发的&lt;br /&gt;心血管医学研究">Cardiovascular research,<br />grounded in clinical questions.</h1>
      <p class="home-hero-tagline" data-en="The Zhang Li and Qishan Chen Research Group at Xinhua Hospital." data-zh="上海交通大学医学院附属新华医院张力/陈齐山课题组">The Zhang Li and Qishan Chen Research Group at Xinhua Hospital.</p>
      <p class="home-hero-links">
        <a class="button" href="/collections/"><span data-en="Research Areas" data-zh="研究方向">Research Areas</span> <span aria-hidden="true">&rarr;</span></a>
        <a class="button is-secondary" href="/our-team/"><span data-en="Team" data-zh="团队">Team</span> <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>

    <div class="home-hero-media" data-home-hero-media>
      <img src="/assets/home/cardiovascular-figure.jpg" alt="Cardiovascular fluorescence microscopy image" />
    </div>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  const header = document.querySelector<HTMLElement>('[data-scroll-header]');

  if (hero) {
    let frame = 0;

    const updateHero = () => {
      frame = 0;
      // The sticky header stays on screen, so the scene lives in the space below it.
      const headerHeight = header?.offsetHeight ?? 0;
      const stage = window.innerHeight - headerHeight;
      const sceneLength = Math.max(hero.offsetHeight - stage, 1);
      const raw = Math.min(Math.max((headerHeight - hero.getBoundingClientRect().top) / sceneLength, 0), 1);
      const progress = Math.min(raw / 0.7, 1);
      const eased = progress * progress * (3 - 2 * progress);

      const startInset = Math.min(48, Math.max(16, window.innerWidth * 0.03));
      const startHeight = Math.max(stage * 0.72, 380);
      const peek = Math.min(280, Math.max(150, stage * 0.3));

      hero.style.setProperty('--hero-top', `${headerHeight}px`);
      hero.style.setProperty('--hero-stage', `${stage}px`);
      hero.style.setProperty('--hero-media-top', `${(stage - peek) * (1 - eased)}px`);
      hero.style.setProperty('--hero-media-inset', `${startInset * (1 - eased)}px`);
      hero.style.setProperty('--hero-media-height', `${startHeight + (stage - startHeight) * eased}px`);
      hero.style.setProperty('--hero-media-radius', `${12 * (1 - eased)}px`);
      hero.style.setProperty('--hero-copy-opacity', `${Math.max(0, 1 - raw * 2.6)}`);
    };

    const requestUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateHero);
    };

    updateHero();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  }
</script>

<style>
  .home-hero {
    position: relative;
    z-index: 2;
    height: 220vh;
    height: 220dvh;
    background: var(--paper);
  }

  .home-hero-sticky {
    position: sticky;
    top: var(--hero-top, 96px);
    height: var(--hero-stage, calc(100vh - 96px));
    overflow: hidden;
  }

  .home-hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: min(calc(100% - 48px), 1120px);
    height: 100%;
    margin: 0 auto;
    padding: clamp(24px, 4vh, 56px) 0 clamp(210px, 32vh, 340px);
    opacity: var(--hero-copy-opacity, 1);
  }

  .home-hero-title {
    max-width: 960px;
    margin: 0;
    font-family: var(--font-title);
    font-size: clamp(40px, 6vw, 92px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  :global(html[lang="zh-CN"]) .home-hero-title {
    font-size: clamp(40px, 5.6vw, 88px);
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .home-hero-tagline {
    max-width: 640px;
    margin: clamp(18px, 2.6vh, 32px) 0 0;
    color: var(--muted);
    font-size: clamp(17px, 1.4vw, 22px);
    line-height: 1.55;
  }

  .home-hero-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 32px;
    margin: clamp(18px, 2.6vh, 30px) 0 0;
  }

  .home-hero-media {
    position: absolute;
    z-index: 3;
    top: var(--hero-media-top, 70%);
    right: var(--hero-media-inset, 48px);
    left: var(--hero-media-inset, 48px);
    height: var(--hero-media-height, 72%);
    overflow: hidden;
    border-radius: var(--hero-media-radius, 12px);
    background: #050505;
    will-change: top, left, right, height, border-radius;
  }

  .home-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .home-hero-content { width: calc(100% - 32px); }
  }
</style>
