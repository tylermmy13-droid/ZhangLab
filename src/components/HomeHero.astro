<script>
  const hero = document.querySelector<HTMLElement>('[data-home-hero]');
  const header = document.querySelector<HTMLElement>('[data-scroll-header]');

  if (hero) {
    let frame = 0;
    const updateHero = () => {
      frame = 0;
      const stage = window.innerHeight - (header?.offsetHeight ?? 0);
      const sceneLength = Math.max(hero.offsetHeight - stage, 1);
      const progress = Math.min(Math.max(-hero.getBoundingClientRect().top / sceneLength, 0), 1);
      hero.style.setProperty('--hero-top', `${header?.offsetHeight ?? 0}px`);
      hero.style.setProperty('--hero-stage', `${stage}px`);
      hero.style.setProperty('--hero-image-shift', `${progress * -36}px`);
      hero.style.setProperty('--hero-sheet-turn', `${progress * -3}deg`);
    };
    const requestUpdate = () => { if (!frame) frame = window.requestAnimationFrame(updateHero); };
    updateHero();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  }
</script>

